      "local": {
        "id": "browser_review_sound",
        "mode": "structure",
        "comment": "Reviewing in the browser (docs/en/design/web-ui.md): `inka serve --as` records\nthe same record `inka review` writes. The four leaves are the conditions the\ndesign puts on that; each is covered by tests today and is to be bound to them.",
        "description": "A decision recorded from the browser is the judgement `inka review` would have recorded: taken on the whole local view, on the content that was on screen, by the approver the server was started as",
        "evidence": null,
        "children": {
          "comment": null,
          "entries": [
            {
              "id": "web_shows_whole_local_view",
              "comment": null,
              "description": "The Web UI offers a decision only under a target's whole local view, shown without any interaction and with nothing deeper; only the exact spacing of a description is read in its source"
            },
            {
              "id": "web_binds_hash_on_screen",
              "comment": null,
              "description": "A decision made in the browser names the view hash that was displayed, and is recorded only if that is still the target's current hash"
            },
            {
              "id": "web_identity_is_servers",
              "comment": null,
              "description": "The approver and the key id of a decision made in the browser are fixed when the server starts; no request can choose or change them"
            },
            {
              "id": "web_only_own_pages_record",
              "comment": null,
              "description": "A server that records decisions listens on a loopback address only and accepts a decision only from a page it served for that run"
            }
          ]
        },
        "deadline": null
      }
