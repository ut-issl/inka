objective root {
    ```
    the mission succeeds
    ```
    children:
        branch,
        declined_leaf,
        expired_leaf,
        tested,
        failing,
        partial,
        modelled,
        calc_failing,
        calc_incomplete,
        calc_invalid,
        calc_xfail,
        calc_assuming
}

structure branch {
    ```
    the subsystem works
    ```
    children: leaf
}

fiat leaf {
    ```
    taken as given
    ```
}

fiat expired_leaf {
    ```
    holds until the design freeze
    ```
    until: M2
}

bind tested {
    ```
    checked in CI
    ```
    test: "tests/hash_props.rs"
}

bind failing {
    ```
    the regression stays fixed
    ```
    test: "tests/failing.rs::regression"
}

bind partial {
    ```
    every platform is exercised
    ```
    test: "tests/partial.rs::matrix"
}

bind modelled {
    ```
    the controller detumbles
    ```
    calc: "AOCS::?verify_detumble"
}

bind calc_failing {
    ```
    the power margin stays positive
    ```
    calc: "Power::?verify_margin"
}

bind calc_incomplete {
    ```
    the thermal margin is reported
    ```
    calc: "Thermal::?verify_margin"
}

bind calc_invalid {
    ```
    the battery reserve holds
    ```
    calc: "Power::?verify_reserve"
}

bind calc_xfail {
    ```
    the known shortfall is tracked
    ```
    calc: "Power::?verify_shortfall"
}

bind calc_assuming {
    ```
    the eclipse budget closes
    ```
    calc: "Power::?verify_eclipse"
}

fiat declined_leaf {
    ```
    the margin is sufficient
    ```
}
