{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "js",
    "tests",
    "pkg/*.d.ts"
  ],
  "exclude": [
    "tests/fixtures"
  ]
}
