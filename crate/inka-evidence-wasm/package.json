{
  "name": "@ut-issl/inka-evidence",
  "version": "0.1.0",
  "private": true,
  "description": "Emit inka test evidence v1 JSON from JavaScript test adapters",
  "main": "pkg/inka_evidence_wasm.js",
  "types": "pkg/inka_evidence_wasm.d.ts",
  "scripts": {
    "build": "wasm-pack build --release --target nodejs",
    "test": "npm run build && vitest run",
    "typecheck": "npm run build && tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "ajv": "8.20.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wasm-pack": "0.15.0"
  }
}
