{
  "name": "@ut-issl/inka-evidence",
  "version": "0.1.0",
  "private": true,
  "description": "Emit inka test evidence v1 JSON from JavaScript test adapters",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "peerDependencies": {
    "vitest": ">=5"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "main": "pkg/inka_evidence_wasm.js",
  "types": "pkg/inka_evidence_wasm.d.ts",
  "exports": {
    ".": {
      "types": "./pkg/inka_evidence_wasm.d.ts",
      "default": "./pkg/inka_evidence_wasm.js"
    },
    "./vitest": {
      "types": "./dist/vitest.d.ts",
      "default": "./dist/vitest.js"
    }
  },
  "scripts": {
    "build": "wasm-pack build --release --target nodejs && tsc -p tsconfig.build.json",
    "test": "npm run build && vitest run",
    "typecheck": "npm run build && tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "ajv": "8.20.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wasm-pack": "0.15.0"
  },
  "dependencies": {
    "@babel/parser": "8.0.8"
  },
  "bin": {
    "inka-evidence-merge": "dist/merge-cli.js"
  }
}
