{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/out/**/*.js"
      ],
      "env": {
        "INKA_LSP_DEV_SERVER": "${workspaceFolder}/../../target/debug/inka-lsp"
      },
      "windows": {
        "env": {
          "INKA_LSP_DEV_SERVER": "${workspaceFolder}\\..\\..\\target\\debug\\inka-lsp.exe"
        }
      },
      "preLaunchTask": "build extension and server"
    }
  ]
}
