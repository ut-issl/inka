{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "compile",
      "label": "npm: compile",
      "problemMatcher": "$tsc"
    },
    {
      "label": "cargo: build inka-lsp",
      "type": "shell",
      "command": "cargo",
      "args": [
        "build",
        "-p",
        "inka-lsp"
      ],
      "options": {
        "cwd": "${workspaceFolder}/../.."
      },
      "problemMatcher": []
    },
    {
      "label": "build extension and server",
      "dependsOn": [
        "npm: compile",
        "cargo: build inka-lsp"
      ],
      "problemMatcher": []
    }
  ]
}
