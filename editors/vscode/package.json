{
  "name": "inka-vscode",
  "displayName": "inka",
  "description": "Language support for the inka argumentation DSL",
  "version": "0.0.1",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "publisher": "ut-issl",
  "repository": {
    "type": "git",
    "url": "https://github.com/ut-issl/inka"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "restrictedConfigurations": [
        "inka.serverPath"
      ]
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "inka",
        "aliases": [
          "inka"
        ],
        "extensions": [
          ".inka"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "inka",
        "scopeName": "source.inka",
        "path": "./syntaxes/inka.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[inka]": {
        "editor.inlayHints.maximumLength": 0
      }
    },
    "semanticTokenTypes": [
      {
        "id": "markupHeading",
        "description": "A Markdown heading inside an inka description"
      },
      {
        "id": "markupBold",
        "description": "Bold Markdown text inside an inka description"
      },
      {
        "id": "markupItalic",
        "description": "Italic Markdown text inside an inka description"
      },
      {
        "id": "markupCode",
        "description": "Markdown code inside an inka description"
      },
      {
        "id": "markupLink",
        "description": "A Markdown link inside an inka description"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "inka",
        "scopes": {
          "markupHeading": [
            "markup.heading"
          ],
          "markupBold": [
            "markup.bold"
          ],
          "markupItalic": [
            "markup.italic"
          ],
          "markupCode": [
            "markup.inline.raw"
          ],
          "markupLink": [
            "markup.underline.link"
          ]
        }
      }
    ],
    "configuration": {
      "title": "inka",
      "properties": {
        "inka.serverPath": {
          "type": "string",
          "default": "inka-lsp",
          "scope": "machine-overridable",
          "markdownDescription": "Command used to launch the inka language server. Build it with `cargo build -p inka-lsp` or install it on `PATH`; otherwise set an absolute path (`${workspaceFolder}` is not expanded in settings)."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "check": "tsc -p . --noEmit"
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/vscode": "1.145.0",
    "typescript": "7.0.2"
  }
}
