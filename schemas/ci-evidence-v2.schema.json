{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.space.t.u-tokyo.ac.jp/inka/schemas/ci-evidence-v2.schema.json",
  "title": "Inka CI evidence bundle v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 2
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "id",
        "revision"
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        }
      },
      "required": [
        "id",
        "attempt"
      ]
    },
    "environment": {
      "type": "object"
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "kind": {
            "enum": [
              "file",
              "function"
            ]
          },
          "profile": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "content": {
            "type": "string",
            "minLength": 1
          },
          "interface_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "required": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "case": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "result": {
                  "enum": [
                    "pass",
                    "fail",
                    "skip",
                    "cancelled"
                  ]
                }
              },
              "required": [
                "case",
                "result"
              ]
            }
          }
        },
        "required": [
          "id",
          "kind",
          "profile",
          "content",
          "interface_hash",
          "required",
          "results"
        ]
      }
    }
  },
  "required": [
    "v",
    "source",
    "execution",
    "targets"
  ]
}
